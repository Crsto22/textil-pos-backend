COOKIE_DOMAIN=.kiments.tech
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=https://kiments.tech,https://www.kiments.tech,https://crm.kiments.tech
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Pool MySQL del backend
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_KEEPALIVE_TIME_MS=300000
# Registra el origen de una conexion retenida por mas de 20 segundos.
DB_POOL_LEAK_DETECTION_MS=20000

WHATSAPP_BRIDGE_PORT=8095
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8095
WHATSAPP_BRIDGE_TOKEN=change-me
WHATSAPP_CLIENT_ID=kiments-main
WHATSAPP_LOG_LEVEL=info
BACKEND_BASE_URL=http://backend:8080
BACKEND_WEBHOOK_PATH=/api/crm/whatsapp/webhook

# IA del CRM: la clave permanece solo en el backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
# Configure una vez con al menos 32 caracteres. Permite cifrar las claves guardadas desde el CRM.
AI_SECRETS_MASTER_KEY=
CRM_AI_WORKER_DELAY_MS=2000
CRM_AI_WORKER_BATCH_SIZE=5
CRM_AI_WORKER_LOCK_MINUTES=5
ECOMMERCE_PUBLIC_URL=https://kiments.com.pe
